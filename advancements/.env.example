# =============================================================================
# Kernel Coding Agent — Environment Configuration
# =============================================================================
# Copy to .env and fill in your values.

# --- LLM Provider ---
# Options: openai, google, anthropic
LLM_PROVIDER=google

# --- API Keys (set the one matching your provider) ---
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# --- Model Selection (medium token consumption defaults) ---
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Agent Configuration ---
MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=120
MAX_TOTAL_TOKENS=50000

# --- Jira (future — currently using mock) ---
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=KERN

# --- Codebase ---
# Leave empty to use sample/mock codebase
KERNEL_REPO_PATH=
TARGET_ARCH=arm64

# --- Evolution Store ---
EVOLUTION_DB_PATH=.kca/evolution.db
